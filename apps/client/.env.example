# Copy to .env (or .env.local) to override. Both are optional.
#
# By default the client connects to ws(s)://<the page's own hostname>:2567,
# which works on localhost and from another device via the LAN IP.

# Port the Colyseus server listens on (must match PORT for @catan/server).
# VITE_SERVER_PORT=2567

# Full override, e.g. a deployed server. Takes precedence over the port.
# VITE_SERVER_URL=wss://catan.example.fly.dev
